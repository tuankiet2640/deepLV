# PostgreSQL
POSTGRES_DB=deeplv
POSTGRES_USER=deeplv
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://deeplv:change-me-in-production@postgres:5432/deeplv

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-generate-64-random-chars-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Model Worker
MODEL_WORKER_URL=http://worker:8001
MODEL_CACHE_SIZE=6
MODEL_DIR=/app/models

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend
VITE_API_URL=http://localhost:8000
