# PostgreSQL
POSTGRES_DB=deeplv
POSTGRES_USER=deeplv
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://deeplv:change-me-in-production@postgres:5432/deeplv

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-generate-64-random-chars-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Encryption key for BYOK provider keys stored in the database (Fernet-based).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-generate-64-random-chars-for-production

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Model Worker
MODEL_WORKER_URL=http://worker:8001
MODEL_CACHE_SIZE=6
MODEL_DIR=/app/models

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Admin-owned provider keys, used when a user pays with platform credits
# instead of bringing their own key (BYOK). Leave blank to disable a
# provider's credit-based path -- users can still BYOK it either way.
# Per-provider credit rates (credits per 1k chars) are configured in the
# admin Settings tab, not here, since they need to change without a redeploy.
ADMIN_OPENAI_KEY=
ADMIN_HUGGINGFACE_KEY=
ADMIN_GOOGLE_KEY=

# Email delivery (Resend), used for signup verification codes and password
# reset links. Leave RESEND_API_KEY blank to log outgoing email instead of
# sending it -- a safe default for local dev (see src/api/services/email.py).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Base URL of the deployed frontend, used to build links in emailed content
# (e.g. the password reset link). Must match your real domain in production.
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
