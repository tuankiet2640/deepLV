# ============================================================
# DeepLV — Railway Environment Variables
# ============================================================
# Set these in Railway Dashboard > Variables (not in the repo!)
# This file is a REFERENCE only — do NOT commit real secrets.
# ============================================================

# --- Database (Supabase Transaction Pooler) ---
DATABASE_URL=postgresql+asyncpg://postgres.odyncoxjkthuwhkrdawi:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Redis (Railway Redis add-on — auto-set if you add one) ---
# If no Redis, the app will still work but without caching/rate-limiting
REDIS_URL=redis://default:password@containers-us-west-XXX.railway.app:6379

# --- JWT ---
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Encryption (for BYOK keys at rest) ---
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_hex_32

# --- CORS (Railway gives you a .up.railway.app domain) ---
CORS_ORIGINS=https://deeplv-production.up.railway.app

# --- Worker (disabled on Railway — no MarianMT, use API providers) ---
MODEL_WORKER_URL=http://localhost:8001

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Credit Pricing ---
CREDIT_COST_PER_1K_CHARS=5.0

# --- Translation Providers (optional — set to enable admin-key mode) ---
ADMIN_OPENAI_KEY=
ADMIN_HUGGINGFACE_KEY=
ADMIN_GOOGLE_KEY=

# --- Logging ---
LOG_LEVEL=info
