FROM python:3.11-slim AS builder

WORKDIR /app
COPY pyproject.toml .

# Install build dependencies for native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && pip install --no-cache-dir . \
    && apt-get purge -y build-essential \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Download and convert models during build
COPY scripts/ scripts/
RUN python scripts/download_models.py --output-dir ./models --pairs en-vi vi-en en-ja ja-en

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/models /app/models

COPY src/ src/
COPY scripts/ scripts/

ENV MODEL_DIR=/app/models
ENV MODEL_CACHE_SIZE=4

EXPOSE 8001

# Single worker to minimize memory — MarianMT models are the bottleneck
CMD ["uvicorn", "src.worker.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--timeout-keep-alive", "30"]
