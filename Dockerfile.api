FROM python:3.11-slim AS builder

WORKDIR /app
COPY pyproject.toml .

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && pip install --no-cache-dir . \
    && pip install --no-cache-dir email-validator \
    && apt-get purge -y build-essential \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ src/
COPY migrations/ migrations/
COPY alembic.ini .

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -f http://localhost:8000/health || exit 1

# Single worker — Supabase handles the DB scaling, API is lightweight
# Migrations run inside the app's startup lifespan (src/api/main.py), after
# table creation, not here — running `alembic upgrade head` before uvicorn
# starts would race Base.metadata.create_all() on a brand new database.
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-keep-alive", "30"]
