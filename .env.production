# ============================================================
# DeepLV Production Environment Configuration
# ============================================================
# Copy this to .env and fill in your values
# All secrets MUST be changed from defaults before deploying
# ============================================================

# --- Domain & Networking ---
# Your public domain (Cloudflare Tunnel will route traffic here)
DOMAIN=translate.yourdomain.com
CORS_ORIGINS=https://translate.yourdomain.com

# --- Supabase PostgreSQL ---
# Get these from: Supabase Dashboard > Project Settings > Database
# Use the "Connection Pooling" URI (port 6543, transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0

# --- Redis (local, runs in Docker) ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Encryption Key (for BYOK API keys at rest) ---
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- API Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Model Worker ---
MODEL_WORKER_URL=http://worker:8001
MODEL_CACHE_SIZE=3
MODEL_DIR=/app/models

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Translation Providers (Admin keys — users pay credits to use these) ---
# Leave blank to disable a provider's admin-key mode
ADMIN_OPENAI_KEY=
ADMIN_HUGGINGFACE_KEY=
ADMIN_GOOGLE_KEY=

# --- Credit Pricing ---
CREDIT_COST_PER_1K_CHARS=5.0

# --- Cloudflare Tunnel ---
# Get this from: https://one.dash.cloudflare.com > Access > Tunnels > Create
# Copy the tunnel token after creating a tunnel
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TUNNEL_TOKEN_HERE

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Frontend Build ---
VITE_API_URL=https://translate.yourdomain.com
